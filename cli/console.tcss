Screen {
    background: #1e1e2e;
    color: #cdd6f4;
}

#frame {
    height: 100%;
    border: heavy #45475a;
    background: #1e1e2e;
}

#header {
    height: 3;
    padding: 0 1;
    color: #cdd6f4;
    background: #181825;
    text-style: bold;
    border-bottom: solid #45475a;
}

#header-title {
    width: 1fr;
    height: 3;
    content-align: left middle;
}

#family {
    width: 42;
    height: 3;
    background: #11111b;
}

#catalog {
    height: 1fr;
}

#actions {
    width: 36;
    height: 1fr;
    border-right: solid #45475a;
    background: #181825;
    color: #cdd6f4;
}

#detail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#summary {
    height: auto;
    color: #cba6f7;
    padding-bottom: 1;
}

#form {
    height: 1fr;
}

.field-label {
    color: #a6adc8;
    margin-top: 1;
}

Input {
    background: #11111b;
    color: #cdd6f4;
    border: solid #45475a;
}

#jobs, #results, #run {
    height: 1fr;
}

#job-table, #result-table {
    height: 12;
    background: #181825;
}

#job-log, #review-log, #run-log {
    height: 1fr;
    padding: 0 1;
    background: #11111b;
    color: #a6adc8;
    border-top: solid #45475a;
}

#run-header {
    height: 3;
    padding: 0 1;
    color: #a6e3a1;
    background: #181825;
}

#status {
    height: 1;
    padding: 0 1;
    background: #313244;
    color: #cdd6f4;
    text-style: bold;
}
