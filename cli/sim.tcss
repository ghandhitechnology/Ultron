Screen {
    background: #1e1e2e;
    color: #cdd6f4;
}

#frame {
    height: 100%;
    border: heavy #45475a;
    background: #1e1e2e;
}

#header {
    height: 3;
    padding: 0 1;
    color: #cdd6f4;
    background: #181825;
    text-style: bold;
    border-bottom: solid #45475a;
}

#arena {
    height: 5;
    padding: 0 1;
    background: #181825;
    border-bottom: solid #45475a;
}

#attacker, #sandbox, #defender {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    border: none;
    border-right: solid #45475a;
    background: #181825;
}

#defender {
    border-right: none;
}

#attacker {
    color: #f38ba8;
}

#sandbox {
    color: #cba6f7;
}

#defender {
    color: #a6e3a1;
}

#attacker:hover, #sandbox:hover, #defender:hover, #attacker:focus, #sandbox:focus, #defender:focus {
    background: #24243b;
}

#detail {
    height: 9;
    padding: 1 2;
    border-bottom: solid #6c5ce7;
    background: #24243b;
    color: #cdd6f4;
}

#transcript-header {
    height: 2;
    margin: 0 1;
    padding: 0 1;
    content-align: left middle;
    background: #302f55;
    color: #e5e7f2;
    text-style: bold;
}

#log {
    height: 1fr;
    min-height: 12;
    padding: 1 2;
    background: #1e1e2e;
    color: #e5e7f2;
    scrollbar-background: #181825;
    scrollbar-color: #585b70;
    scrollbar-color-hover: #6c5ce7;
    scrollbar-color-active: #89b4fa;
}

#progress {
    height: 4;
    padding: 0 1;
    color: #a6e3a1;
    background: #181825;
    border-top: solid #45475a;
}

#status {
    height: 1;
    padding: 0 1;
    background: #313244;
    color: #cdd6f4;
    text-style: bold;
}
