Screen {
    background: #11111b;
    color: #cdd6f4;
}

#frame {
    height: 100%;
    border: heavy #585b70;
    background: #1e1e2e;
}

#header {
    height: 3;
    padding: 0 1;
    color: #cdd6f4;
    background: #181825;
    text-style: bold;
    border-bottom: heavy #6c5ce7;
}

#header-title {
    width: 1fr;
    height: 3;
    content-align: left middle;
}

#telemetry {
    width: 34;
    height: 3;
    padding: 0 1;
    content-align: right middle;
    background: #181825;
}

#sprites {
    height: 9;
    padding: 0 1;
    content-align: center middle;
    color: #cdd6f4;
    background: #11111b;
    border-bottom: heavy #45475a;
}

#family {
    width: 34;
    height: 3;
    background: #11111b;
}

#catalog {
    height: 1fr;
}

#actions {
    width: 34;
    height: 1fr;
    border-right: heavy #585b70;
    background: #181825;
    color: #cdd6f4;
}

#detail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: #1e1e2e;
}

#summary {
    height: auto;
    color: #cba6f7;
    padding-bottom: 1;
}

#form {
    height: 1fr;
}

.field-label {
    color: #a6adc8;
    margin-top: 1;
}

Input {
    background: #11111b;
    color: #cdd6f4;
    border: solid #45475a;
}

Input:focus {
    border: heavy #89b4fa;
    background: #181825;
}

OptionList > .option-list--option-highlighted {
    background: #45475a;
    color: #ffffff;
    text-style: bold;
}

#jobs, #results, #run {
    height: 1fr;
}

#job-table, #result-table {
    height: 12;
    background: #181825;
    border-bottom: heavy #45475a;
}

#job-log, #review-log, #run-log {
    height: 1fr;
    padding: 0 1;
    background: #11111b;
    color: #a6adc8;
    border-top: solid #45475a;
}

#run-header {
    height: 3;
    padding: 0 1;
    color: #a6e3a1;
    background: #181825;
    border-bottom: heavy #45475a;
}

#status {
    height: 1;
    padding: 0 1;
    background: #3b3b68;
    color: #cdd6f4;
    text-style: bold;
}
